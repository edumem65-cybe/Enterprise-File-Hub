{
  "name": "enterprise-file-hub",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "compose:up": "docker compose --env-file .env -f infra/compose/docker-compose.dev.yml up -d",
    "compose:down": "docker compose --env-file .env -f infra/compose/docker-compose.dev.yml down",
    "compose:check": "docker compose --env-file .env.example -f infra/compose/docker-compose.dev.yml config -q"
  }
}
